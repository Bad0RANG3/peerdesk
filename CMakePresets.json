{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-mingw",
      "displayName": "Windows / Qt 6.8 / MinGW",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.8.3/mingw_64",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe"
      }
    },
    {
      "name": "windows-mingw-ci",
      "displayName": "Windows / Qt 6.8 / MinGW (CI)",
      "inherits": "windows-mingw",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
        "CMAKE_C_COMPILER": "$env{IQTA_TOOLS}/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{IQTA_TOOLS}/mingw1310_64/bin/g++.exe"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows / Qt 6.8 / MinGW / Release",
      "inherits": "windows-mingw",
      "binaryDir": "${sourceDir}/build/cpp-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-mingw-ci-release",
      "displayName": "Windows / Qt 6.8 / MinGW / Release (CI)",
      "inherits": "windows-mingw-ci",
      "binaryDir": "${sourceDir}/build/cpp-ci-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "jobs": 8
    },
    {
      "name": "windows-mingw-ci",
      "configurePreset": "windows-mingw-ci",
      "jobs": 4
    },
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release",
      "jobs": 8
    },
    {
      "name": "windows-mingw-ci-release",
      "configurePreset": "windows-mingw-ci-release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-mingw-ci",
      "configurePreset": "windows-mingw-ci",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
